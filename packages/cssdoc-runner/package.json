{
  "name": "@hia-doc/cssdoc-runner",
  "version": "1.0.0",
  "description": "Standalone CSSDoc project runner and CLI.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./schemas/cssdoc-config-0.1.0-draft.schema.json": "./src/schemas/cssdoc-config-0.1.0-draft.schema.json",
    "./schemas/cssdoc-config-1.0.0.schema.json": "./src/schemas/cssdoc-config-1.0.0.schema.json"
  },
  "bin": {

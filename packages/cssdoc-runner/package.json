    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mandolin/hia-cssdoc.git",
    "directory": "packages/cssdoc-runner"
  },
  "homepage": "https://github.com/mandolin/hia-cssdoc/tree/main/packages/cssdoc-runner",
  "bugs": {

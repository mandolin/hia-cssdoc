{
  "schemaVersion": "1.0.0",
  "workspaceRoot": ".",
  "outputDirectory": "dist/cssdoc",
  "inputs": [
    {
      "kind": "css",
      "path": "src/components.css"
    },
    {
      "kind": "postcss-css",
      "path": "generated/utilities.postcss.css"
    },
    {
      "kind": "design-token",
      "path": "tokens/theme.tokens.json"
    }
  ],
  "options": {
    "emitDocSourceMap": true,
    "sourcesContentPolicy": "none",
    "writeResultManifest": true
  }
}
